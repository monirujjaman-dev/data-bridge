<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DataBridge.Desktop.ViewModels"
             xmlns:views="using:DataBridge.Desktop.Views"
             x:Class="DataBridge.Desktop.App"
             RequestedThemeVariant="Default">

  <!-- Light and dark follow the OS (FR-UI-005): RequestedThemeVariant="Default". -->
  <Application.Styles>
    <StyleInclude Source="avares://DataBridge.Desktop/Themes/DataBridgeTheme.axaml" />
  </Application.Styles>

  <!-- Each page view model is shown by its view. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:ConnectionsViewModel">
      <views:ConnectionsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SchemaComparisonViewModel">
      <views:SchemaComparisonView />
    </DataTemplate>
    <DataTemplate DataType="vm:DataComparisonViewModel">
      <views:DataComparisonView />
    </DataTemplate>
    <DataTemplate DataType="vm:SynchronizationViewModel">
      <views:SynchronizationView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
