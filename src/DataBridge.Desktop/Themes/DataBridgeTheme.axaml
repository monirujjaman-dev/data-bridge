<!--
  DataBridge application theme entry point.
  Usage in App.axaml:
    <Application.Styles>
      <StyleInclude Source="avares://DataBridge.Desktop/Themes/DataBridgeTheme.axaml" />
    </Application.Styles>
  and RequestedThemeVariant="Default" so the OS light/dark setting wins.
  The Fluent palettes below re-tint every stock control from the DataBridge tokens.
  Accent is the brand accent blue #2563EB in both themes; Fluent derives its lighter and darker steps.
  Requires packages: Avalonia.Themes.Fluent, Avalonia.Controls.DataGrid.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Light"
                             Accent="#2563EB"
                             RegionColor="#F1F5F9"
                             AltHigh="#FFFFFF"
                             BaseHigh="#0F172A"
                             BaseMediumHigh="#334155"
                             BaseMedium="#475569"
                             BaseMediumLow="#64748B"
                             BaseLow="#D5DDE7"
                             ChromeLow="#F8FAFC"
                             ChromeMediumLow="#EEF2F7"
                             ChromeMedium="#E2E8F0"
                             ChromeHigh="#CBD5E1"
                             ChromeAltLow="#0F172A"
                             ChromeGray="#64748B"
                             ListLow="#E2E8F0"
                             ListMedium="#CBD5E1"
                             ErrorText="#B3261E" />
      <ColorPaletteResources x:Key="Dark"
                             Accent="#2563EB"
                             RegionColor="#0B1220"
                             AltHigh="#080D18"
                             BaseHigh="#F1F5F9"
                             BaseMediumHigh="#CBD5E1"
                             BaseMedium="#94A3B8"
                             BaseMediumLow="#64748B"
                             BaseLow="#273449"
                             ChromeLow="#0F1726"
                             ChromeMediumLow="#141D2F"
                             ChromeMedium="#1B2539"
                             ChromeHigh="#3B4A61"
                             ChromeAltLow="#F1F5F9"
                             ChromeGray="#8D99AB"
                             ListLow="#1E293B"
                             ListMedium="#2A3850"
                             ErrorText="#F2766B" />
    </FluentTheme.Palettes>
  </FluentTheme>

  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DataBridge.Desktop/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://DataBridge.Desktop/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <StyleInclude Source="avares://DataBridge.Desktop/Themes/Controls.axaml" />

</Styles>
