<!--
  DataBridge control styles: "Wayfinding Signage".
  Stock Fluent controls stay the controls users know; these styles apply type,
  density, palette and the one signature element, the route sign.
  Classes are documented in DESIGN.md.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Window and base text -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource DbGroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource DbFontUi}" />
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeBody}" />
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="2" Margin="-3" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeDisplay}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="32" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="26" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
  </Style>
  <!-- Sign and column labels: small, bold, tracked caps. Never an eyebrow above a page heading. -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.numeric">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <!-- Monospace is for SQL, identifiers and measured values only. :is() also matches SelectableTextBlock. -->
  <Style Selector=":is(TextBlock).code">
    <Setter Property="FontFamily" Value="{StaticResource DbFontCode}" />
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource DbCodeBrush}" />
    <Setter Property="LineHeight" Value="19" />
    <!-- SQL never soft-wraps: a wrapped line at column 0 reads as a new statement. Host code in a horizontal ScrollViewer. -->
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style Selector="TextBox.code">
    <Setter Property="FontFamily" Value="{StaticResource DbFontCode}" />
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
  </Style>
  <Style Selector="TextBlock.add"><Setter Property="Foreground" Value="{DynamicResource DbAddBrush}" /></Style>
  <Style Selector="TextBlock.info"><Setter Property="Foreground" Value="{DynamicResource DbInfoBrush}" /></Style>
  <Style Selector="TextBlock.caution"><Setter Property="Foreground" Value="{DynamicResource DbCautionBrush}" /></Style>
  <Style Selector="TextBlock.danger"><Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" /></Style>

  <Style Selector="SelectableTextBlock">
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="SelectionForegroundBrush" Value="White" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="SelectionForegroundBrush" Value="White" />
  </Style>

  <!-- Surfaces. Elevation has one rank: only overlays lift; panels are flat with hairlines. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource DbPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbHairlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{StaticResource DbPanelPadding}" />
  </Style>
  <Style Selector="Border.sunken">
    <Setter Property="Background" Value="{DynamicResource DbSunkenBrush}" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.toolbar">
    <Setter Property="Background" Value="{DynamicResource DbPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbHairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Border.statusbar">
    <Setter Property="Background" Value="{DynamicResource DbPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbHairlineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,4" />
  </Style>
  <Style Selector="Border.rail">
    <Setter Property="Background" Value="{DynamicResource DbRailBrush}" />
    <Setter Property="Width" Value="{StaticResource DbRailWidth}" />
  </Style>
  <!-- Callout for destructive or blocking conditions: full danger frame, never a side stripe. -->
  <Style Selector="Border.callout">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbCautionBrush}" />
    <Setter Property="Background" Value="{DynamicResource DbCautionSurfaceBrush}" />
  </Style>
  <Style Selector="Border.callout.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="Background" Value="{DynamicResource DbDangerSurfaceBrush}" />
  </Style>

  <!-- Navigation rail: a ListBox, so arrow keys and Tab work as users expect. Selected item reads in sync teal. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="MinHeight" Value="{StaticResource DbRowHeight}" />
    <Setter Property="Foreground" Value="{StaticResource DbRailTextMutedBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DbRailSelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DbRailTextBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DbRailSelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DbRailTextSelectedBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DbRailSelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource DbRailTextSelectedBrush}" />
  </Style>

  <!--
    Lists outside the rail select like grid rows: a pale accent-blue tint (16% at rest, 24% hovered), text stays
    in text colour, no saturated fill, so glyphs and muted detail lines keep their contrast.
  -->
  <Style Selector="ListBox:not(.nav) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background">
      <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.16" />
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource DbTextBrush}" />
  </Style>
  <Style Selector="ListBox:not(.nav) ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background">
      <SolidColorBrush Color="{DynamicResource SystemAccentColor}" Opacity="0.24" />
    </Setter>
    <Setter Property="Foreground" Value="{DynamicResource DbTextBrush}" />
  </Style>

  <!--
    Route sign: the signature element. Source on the left, signage arrow, target on the right,
    separated by a heavy sign rule. Primary navy with sync-teal direction, same in both themes. Usage in DESIGN.md.
  -->
  <Style Selector="Border.route-sign">
    <Setter Property="Background" Value="{StaticResource DbSignBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource DbSyncBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="{StaticResource DbSignPadding}" />
    <Setter Property="MinHeight" Value="{StaticResource DbSignHeight}" />
  </Style>
  <Style Selector="Border.route-sign TextBlock">
    <Setter Property="Foreground" Value="{StaticResource DbSignTextBrush}" />
  </Style>
  <Style Selector="Border.route-sign TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource DbSignTextBrush}" />
  </Style>
  <Style Selector="Border.route-sign TextBlock.detail">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource DbSignTextMutedBrush}" />
  </Style>
  <Style Selector="Border.route-sign PathIcon.sign-arrow">
    <Setter Property="Data" Value="{StaticResource GlyphSignArrow}" />
    <Setter Property="Foreground" Value="{StaticResource DbSyncBrush}" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
  </Style>
  <Style Selector="Border.route-sign Rectangle.sign-rule">
    <Setter Property="Fill" Value="{StaticResource DbSyncBrush}" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <!-- Same database on both sides, or execution in progress: the sign turns to a warning sign. -->
  <Style Selector="Border.route-sign.alert">
    <Setter Property="Background" Value="{StaticResource DbSignAlertBrush}" />
    <Setter Property="BorderBrush" Value="White" />
  </Style>
  <Style Selector="Border.route-sign.alert TextBlock, Border.route-sign.alert TextBlock.label, Border.route-sign.alert TextBlock.detail">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.route-sign.alert PathIcon.sign-arrow">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.route-sign.alert Rectangle.sign-rule">
    <Setter Property="Fill" Value="White" />
  </Style>

  <!--
    Signal: glyph + label state badge.  Usage:
      <ContentControl Classes="signal cleared" Content="Target fingerprint matches" />
    Variants: add, change, remove, cleared, pending, awaiting, blocked, excluded, warning.
  -->
  <Style Selector="ContentControl.signal">
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
    <Setter Property="Tag" Value="{StaticResource GlyphPending}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Width="12" Height="12" VerticalAlignment="Center"
                    Data="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" />
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"
                            TextElement.Foreground="{DynamicResource DbTextBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ContentControl.signal.add">
    <Setter Property="Tag" Value="{StaticResource GlyphAdd}" />
    <Setter Property="Foreground" Value="{DynamicResource DbAddBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.change">
    <Setter Property="Tag" Value="{StaticResource GlyphChange}" />
    <Setter Property="Foreground" Value="{DynamicResource DbInfoBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.remove">
    <Setter Property="Tag" Value="{StaticResource GlyphRemove}" />
    <Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.cleared">
    <Setter Property="Tag" Value="{StaticResource GlyphCleared}" />
    <Setter Property="Foreground" Value="{DynamicResource DbAddBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.pending">
    <Setter Property="Tag" Value="{StaticResource GlyphPending}" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.awaiting">
    <Setter Property="Tag" Value="{StaticResource GlyphAwaiting}" />
    <Setter Property="Foreground" Value="{DynamicResource DbCautionBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.blocked">
    <Setter Property="Tag" Value="{StaticResource GlyphBlocked}" />
    <Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.excluded">
    <Setter Property="Tag" Value="{StaticResource GlyphExcluded}" />
    <Setter Property="Foreground" Value="{DynamicResource DbExcludedBrush}" />
  </Style>
  <Style Selector="ContentControl.signal.warning">
    <Setter Property="Tag" Value="{StaticResource GlyphWarning}" />
    <Setter Property="Foreground" Value="{DynamicResource DbCautionBrush}" />
  </Style>

  <!-- Magnitude ramp: difference counts share one fixed scale everywhere. -->
  <Style Selector="Rectangle.magnitude">
    <Setter Property="Fill" Value="{DynamicResource DbTextBrush}" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Rectangle.magnitude.danger">
    <Setter Property="Fill" Value="{DynamicResource DbDangerBrush}" />
  </Style>

  <!-- Buttons: stock Fluent buttons; primary uses Fluent's "accent" class (brand accent blue). -->
  <Style Selector="Button">
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="MinHeight" Value="{StaticResource DbRowHeight}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Destructive opt-in: outlined in danger, never filled, so it never reads as the primary action. -->
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="Background" Value="{DynamicResource DbDangerSurfaceBrush}" />
  </Style>
  <!-- Pressed keeps the danger lettering and frame; Fluent's pressed fill stays. -->
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DbDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbDangerBrush}" />
  </Style>
  <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DbExcludedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DbHairlineBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Progress: thin and square. -->
  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Tab strips: compact, semibold. -->
  <Style Selector="TabStripItem, TabItem">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

  <!-- Data grids: dense rows, horizontal hairlines, tabular figures. Always virtualized. -->
  <Style Selector="DataGrid">
    <Setter Property="RowHeight" Value="{StaticResource DbRowHeight}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DbHairlineBrush}" />
    <Setter Property="Background" Value="{DynamicResource DbPanelBrush}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="DataGridCell TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Two-line rows: object name with its detail as a muted second line, so differences scan at 1440 wide. -->
  <Style Selector="DataGrid.two-line">
    <Setter Property="RowHeight" Value="48" />
  </Style>
  <Style Selector="DataGridCell TextBlock.secondary">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
  </Style>
  <!-- Selection: pale accent tint (see DataGridRowSelected*Opacity tokens); no edge stripe. -->
  <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
    <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="Opacity" Value="0.16" />
  </Style>
  <Style Selector="DataGridRow:selected">
    <Setter Property="Foreground" Value="{DynamicResource DbTextBrush}" />
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="FontSize" Value="{StaticResource DbFontSizeCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource DbTextMutedBrush}" />
    <Setter Property="MinHeight" Value="{StaticResource DbRowHeight}" />
    <Setter Property="Padding" Value="12,0,4,0" />
  </Style>

  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="28" />
  </Style>

</Styles>
