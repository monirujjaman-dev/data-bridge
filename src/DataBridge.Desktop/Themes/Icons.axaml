<!--
  DataBridge glyphs, authored on a 16 x 16 grid for PathIcon.
  Every state has its own shape so state never depends on colour alone:
    GlyphAdd       plus            only in source / will be created     (add)
    GlyphChange    diamond         changed                              (info)
    GlyphRemove    minus bar       only in target / would be dropped    (danger)
    GlyphCleared   solid circle    completed, verified                  (add)
    GlyphPending   ring            pending, queued                      (muted)
    GlyphAwaiting  solid square    awaiting approval                    (caution)
    GlyphBlocked   circle with bar blocked, failed, destructive         (danger)
    GlyphExcluded  hollow square   not part of the plan                 (excluded)
    GlyphWarning   triangle        unsupported object, unstable snapshot (caution)
  GlyphSignArrow is the signage arrow used on the route sign.
  The logo mark lives on a 64 x 64 grid; Assets/Brand/databridge-icon.svg is its source.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <StreamGeometry x:Key="GlyphAdd">M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphChange">M8,2 L14,8 L8,14 L2,8 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphRemove">M3,7 H13 V9 H3 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphCleared">M8,2 A6,6 0 1 1 7.99,2 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphPending">F0 M8,2 A6,6 0 1 1 7.99,2 Z M8,4.75 A3.25,3.25 0 1 0 8.01,4.75 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphAwaiting">M3,3 H13 V13 H3 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphBlocked">F0 M8,2 A6,6 0 1 1 7.99,2 Z M4.5,7 H11.5 V9 H4.5 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphExcluded">F0 M3,3 H13 V13 H3 Z M5,5 V11 H11 V5 Z</StreamGeometry>
  <StreamGeometry x:Key="GlyphWarning">F0 M8,1.5 L15,14 H1 Z M7.2,6 H8.8 V10 H7.2 Z M7.2,11 H8.8 V12.6 H7.2 Z</StreamGeometry>

  <!-- Signage arrow: heavy shaft, 45-degree head. -->
  <StreamGeometry x:Key="GlyphSignArrow">M1,6.5 H9.4 L5.6,2.7 H9.6 L14.9,8 L9.6,13.3 H5.6 L9.4,9.5 H1 Z</StreamGeometry>

  <!--
    Logo, 64 x 64: one database cylinder with an amber lightning bolt on a primary-navy tile.
    Fills: cap #60A5FA; bands #2563EB (accent blue), #1D8FD0, #14B8A6 (sync teal); bolt #F59E0B (amber)
    over a 3-wide navy keyline (LogoBolt stroked first, then filled).
  -->
  <StreamGeometry x:Key="LogoTile">M14,0 H50 A14,14 0 0 1 64,14 V50 A14,14 0 0 1 50,64 H14 A14,14 0 0 1 0,50 V14 A14,14 0 0 1 14,0 Z</StreamGeometry>
  <StreamGeometry x:Key="LogoBandTop">M14,15 A18,6 0 0 0 50,15 V25 A18,6 0 0 1 14,25 Z</StreamGeometry>
  <StreamGeometry x:Key="LogoBandMiddle">M14,28 A18,6 0 0 0 50,28 V38 A18,6 0 0 1 14,38 Z</StreamGeometry>
  <StreamGeometry x:Key="LogoBandBottom">M14,41 A18,6 0 0 0 50,41 V50 A18,6 0 0 1 14,50 Z</StreamGeometry>
  <StreamGeometry x:Key="LogoCap">M14,13 A18,6 0 1 0 50,13 A18,6 0 1 0 14,13 Z</StreamGeometry>
  <StreamGeometry x:Key="LogoBolt">M34,17 H43 L37,30 H44 L27,58 L31,36 H24 Z</StreamGeometry>

</ResourceDictionary>
