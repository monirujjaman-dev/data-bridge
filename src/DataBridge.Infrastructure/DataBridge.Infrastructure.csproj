<Project Sdk="Microsoft.NET.Sdk">

  <!-- SQL Server provider, local persistence and credential-store adapters. -->
  <PropertyGroup>
    <RootNamespace>DataBridge.Infrastructure</RootNamespace>
    <!-- The OS credential-store adapters call native APIs through source-generated P/Invoke and function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataBridge.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DataBridge.Application/DataBridge.Application.csproj" />
    <ProjectReference Include="../DataBridge.Core/DataBridge.Core.csproj" />
    <ProjectReference Include="../DataBridge.Shared/DataBridge.Shared.csproj" />
  </ItemGroup>

</Project>
